# MoonBit source and public interfaces.
*.mbt linguist-language=MoonBit
*.mbti linguist-language=MoonBit
# Normalize interfaces regenerated by MoonBit across Windows and Unix hosts.
*.generated.mbti text eol=lf linguist-generated=true

# Moon package manifests are metadata, not AMPL source (.mod).
moon.mod linguist-detectable=false
moon.pkg linguist-detectable=false

# Keep GitHub language statistics focused on the MoonBit application core.
# Native platform code and its fixtures retain their actual syntax highlighting.
*.c linguist-detectable=false
*.cpp linguist-detectable=false
*.h linguist-detectable=false
*.m linguist-detectable=false
*.mm linguist-detectable=false
*.inc linguist-detectable=false
