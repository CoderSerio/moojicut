{
  "name": "mooncap",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first screenshot and screen recording editor with a MoonBit core.",
  "type": "module",
  "main": "src/main/main.mjs",
  "scripts": {
    "build:core": "node scripts/build-core.mjs",
    "build:ui": "node scripts/build-ui.mjs",
    "build:native": "node scripts/build-native.mjs",
    "build": "npm run build:core && npm run build:ui && npm run build:native",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron . --workbench",
    "package": "npm run build && node scripts/package.mjs",
    "agent": "node agent/cli.mjs",
    "mcp": "node agent/mcp.mjs",
    "test": "node scripts/build-core.mjs --test && node --test test/*.test.mjs",
    "check": "node scripts/check.mjs"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "45.3.1"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  }
}
