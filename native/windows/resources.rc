#pragma code_page(65001)
#include <windows.h>
#include <commctrl.h>
#include "resource.h"

IDI_MOOJICUT ICON "app.ico"
1 RT_MANIFEST "app.manifest"

IDD_GENERAL DIALOGEX 0, 0, 320, 207
STYLE DS_SETFONT | DS_FIXEDSYS | WS_CHILD | WS_CAPTION
CAPTION "通用"
FONT 9, "Segoe UI"
BEGIN
    ICON IDI_MOOJICUT, -1, 17, 18, 32, 32
    LTEXT "Mooji Cut", -1, 62, 18, 230, 16
    LTEXT "这一幕，我截下了。", -1, 62, 37, 230, 15
    GROUPBOX "日常使用", -1, 14, 64, 292, 68
    LTEXT "平时驻留在通知区域。双击托盘图标打开设置。\n关闭设置后继续待命；退出请使用托盘菜单。", -1, 25, 81, 267, 26
    CONTROL "启动时打开设置", IDC_START_SETTINGS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 25, 111, 267, 13
    GROUPBOX "内置功能", -1, 14, 143, 292, 60
    CONTROL "启用贴图", IDC_PIN_ENABLED, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 25, 155, 130, 13
    LTEXT "关闭后会关闭所有现有贴图，并停用贴图快捷键。", -1, 25, 173, 267, 13
    LTEXT "", IDC_FEATURE_STATUS, 25, 188, 267, 12
END

IDD_UPDATES DIALOGEX 0, 0, 320, 207
STYLE DS_SETFONT | DS_FIXEDSYS | WS_CHILD | WS_CAPTION
CAPTION "更新"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "GitHub Releases", -1, 17, 18, 285, 16
    LTEXT "检查 Mooji Cut 的公开发布版本。预览版可接收新的预览更新。", -1, 17, 43, 285, 28
    LTEXT "", IDC_UPDATE_STATUS, 17, 80, 285, 49
    PUSHBUTTON "检查更新", IDC_UPDATE_CHECK, 17, 139, 65, 22
    PUSHBUTTON "下载更新包…", IDC_UPDATE_DOWNLOAD, 89, 139, 86, 22
    PUSHBUTTON "取消", IDC_UPDATE_CANCEL, 182, 139, 49, 22
    PUSHBUTTON "打开位置", IDC_UPDATE_OPEN, 238, 139, 64, 22
    LTEXT "下载会校验 SHA256 和文件大小。当前为便携包，请解压后运行新版本；不会自动替换正在运行的程序。", -1, 17, 176, 285, 27
END

IDD_TOOLS DIALOGEX 0, 0, 320, 207
STYLE DS_SETFONT | DS_FIXEDSYS | WS_CHILD | WS_CAPTION
CAPTION "插件管理"
FONT 9, "Segoe UI"
BEGIN
    COMBOBOX IDC_TOOL_GROUP, 17, 13, 285, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LISTBOX IDC_TOOL_LIST, 17, 39, 285, 86, LBS_NOTIFY | WS_VSCROLL | WS_BORDER | WS_TABSTOP
    CONTROL "启用", IDC_TOOL_ENABLED, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 17, 135, 90, 16
    PUSHBUTTON "↑", IDC_TOOL_UP, 226, 132, 35, 22
    PUSHBUTTON "↓", IDC_TOOL_DOWN, 267, 132, 35, 22
    PUSHBUTTON "导入 ZIP…", IDC_TOOL_IMPORT, 17, 159, 90, 22
    PUSHBUTTON "卸载插件", IDC_TOOL_UNINSTALL, 114, 159, 90, 22
    LTEXT "", IDC_TOOL_STATUS, 17, 184, 285, 20
END

IDD_SHORTCUTS DIALOGEX 0, 0, 320, 207
STYLE DS_SETFONT | DS_FIXEDSYS | WS_CHILD | WS_CAPTION
CAPTION "快捷键"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "点击输入框，然后按下快捷键组合。", -1, 17, 17, 285, 13
    LTEXT "截图", -1, 17, 47, 65, 14
    CONTROL "", IDC_HOTKEY_CAPTURE, "msctls_hotkey32", WS_BORDER | WS_TABSTOP, 89, 43, 163, 19
    PUSHBUTTON "清除", IDC_CLEAR_CAPTURE, 260, 43, 43, 19
    LTEXT "开始录屏", -1, 17, 78, 65, 14
    CONTROL "", IDC_HOTKEY_RECORD, "msctls_hotkey32", WS_BORDER | WS_TABSTOP, 89, 74, 163, 19
    PUSHBUTTON "清除", IDC_CLEAR_RECORD, 260, 74, 43, 19
    LTEXT "结束录屏", -1, 17, 109, 65, 14
    CONTROL "", IDC_HOTKEY_STOP, "msctls_hotkey32", WS_BORDER | WS_TABSTOP, 89, 105, 163, 19
    PUSHBUTTON "清除", IDC_CLEAR_STOP, 260, 105, 43, 19
    LTEXT "", IDC_SHORTCUT_STATUS, 17, 138, 190, 31
    PUSHBUTTON "恢复默认", IDC_RESET_SHORTCUTS, 231, 139, 72, 20
    LTEXT "截图、开始录屏、停止录屏已接通。\n输入组合时暂停全局按键，离开输入框后恢复。", -1, 17, 174, 285, 26
END

IDD_ABOUT DIALOGEX 0, 0, 320, 207
STYLE DS_SETFONT | DS_FIXEDSYS | WS_CHILD | WS_CAPTION
CAPTION "关于"
FONT 9, "Segoe UI"
BEGIN
    ICON IDI_MOOJICUT, -1, 17, 18, 32, 32
    LTEXT "Mooji Cut", -1, 62, 18, 230, 16
    LTEXT "", IDC_VERSION, 62, 37, 230, 16
    LTEXT "以 MoonBit 为核心的本地截图与录屏工具。\n捕捉后编辑，确认后复制。", -1, 17, 75, 285, 28
    LTEXT "", IDC_CORE_STATUS, 17, 115, 285, 15
    LTEXT "截图标注与录屏剪辑，确认后复制。\nWindows 本版录制主显示器，不录声音。\n本预览包尚未进行 Windows 代码签名。", -1, 17, 150, 285, 40
END

IDD_PINS DIALOGEX 0, 0, 320, 252
STYLE DS_SETFONT | DS_FIXEDSYS | WS_CHILD | WS_CAPTION
CAPTION "贴图按键"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "单击选中，拖动移动。双击或选中后 Esc 关闭。", -1, 17, 10, 285, 13
    LTEXT "放大", -1, 17, 34, 95, 14
    CONTROL "", IDC_PIN_ZOOM_IN, "msctls_hotkey32", WS_BORDER | WS_TABSTOP, 114, 30, 186, 19
    LTEXT "缩小", -1, 17, 60, 95, 14
    CONTROL "", IDC_PIN_ZOOM_OUT, "msctls_hotkey32", WS_BORDER | WS_TABSTOP, 114, 56, 186, 19
    LTEXT "增加不透明度", -1, 17, 86, 95, 14
    CONTROL "", IDC_PIN_OPACITY_UP, "msctls_hotkey32", WS_BORDER | WS_TABSTOP, 114, 82, 186, 19
    LTEXT "降低不透明度", -1, 17, 112, 95, 14
    CONTROL "", IDC_PIN_OPACITY_DOWN, "msctls_hotkey32", WS_BORDER | WS_TABSTOP, 114, 108, 186, 19
    LTEXT "隐藏 / 恢复", -1, 17, 138, 95, 14
    CONTROL "", IDC_PIN_HIDE, "msctls_hotkey32", WS_BORDER | WS_TABSTOP, 114, 134, 186, 19
    LTEXT "鼠标穿透 / 恢复", -1, 17, 164, 95, 14
    CONTROL "", IDC_PIN_PASSTHROUGH, "msctls_hotkey32", WS_BORDER | WS_TABSTOP, 114, 160, 186, 19
    LTEXT "", IDC_PIN_STATUS, 17, 190, 194, 27
    PUSHBUTTON "恢复默认", IDC_PIN_RESET, 228, 188, 72, 20
    LTEXT "无选中时隐藏全部或恢复已隐藏贴图。\n鼠标穿透期间仅穿透恢复按键有效；恢复后可再次操作。", -1, 17, 222, 286, 26
END
