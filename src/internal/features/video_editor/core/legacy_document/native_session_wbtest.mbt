///|
test "native video export plan keeps source cuts and output offsets distinct" {
  let handle = native_video_open(10000, 1920, 1080, 1)
  assert_true(handle > 0)
  assert_eq(native_video_crop_value(handle, 0), 0)
  assert_eq(native_video_crop_value(handle, 2), 1920)
  assert_eq(native_video_trim(handle, 1000, 9000), 1)
  assert_eq(native_video_cut(handle, 2000, 4000), 1)
  assert_eq(native_video_cut(handle, 3500, 5000), 1)
  assert_eq(native_video_duration(handle), 5000)
  assert_eq(native_video_segment_count(handle), 2)
  assert_eq(native_video_segment_value(handle, 0, 0), 1000)
  assert_eq(native_video_segment_value(handle, 0, 1), 2000)
  assert_eq(native_video_segment_value(handle, 0, 2), 0)
  assert_eq(native_video_segment_value(handle, 0, 3), 1000)
  assert_eq(native_video_segment_value(handle, 1, 0), 5000)
  assert_eq(native_video_segment_value(handle, 1, 1), 9000)
  assert_eq(native_video_segment_value(handle, 1, 2), 1000)
  assert_eq(native_video_segment_value(handle, 1, 3), 5000)
  assert_eq(native_video_crop(handle, 11, 17, 501, 301), 1)
  assert_eq(native_video_crop_value(handle, 0), 11)
  assert_eq(native_video_crop_value(handle, 1), 17)
  assert_eq(native_video_crop_value(handle, 2), 500)
  assert_eq(native_video_crop_value(handle, 3), 300)
  assert_eq(native_video_mute(handle, 1), 1)
  assert_eq(native_video_edit_value(handle, 0), 1000)
  assert_eq(native_video_edit_value(handle, 1), 9000)
  assert_eq(native_video_edit_value(handle, 2), 1)
  assert_eq(native_video_edit_value(handle, 3), 1)
  assert_eq(native_video_edit_value(handle, 4), 0)
  assert_eq(native_video_edit_value(handle, 5), 2)
  assert_eq(native_video_undo(handle), 1)
  assert_eq(native_video_edit_value(handle, 2), 0)
  assert_eq(native_video_edit_value(handle, 4), 1)
  assert_eq(native_video_redo(handle), 1)
  let document = @json.parse(native_video_snapshot(handle))
  assert_eq(@test_support.model_test_field(document, "muted"), Json(true))
  assert_eq(native_video_reset_crop(handle), 1)
  assert_eq(native_video_crop_value(handle, 2), 1920)
  assert_eq(native_video_clear_cuts(handle), 1)
  assert_eq(native_video_duration(handle), 8000)
  native_video_close(handle)
}

///|
test "native video rejects invalid edits atomically and resumes real drafts" {
  let handle = native_video_open(10000, 1920, 1080, 1)
  assert_eq(native_video_trim(handle, 1000, 9000), 1)
  assert_eq(native_video_cut(handle, 3000, 4000), 1)
  let before = native_video_snapshot(handle)
  assert_eq(native_video_cut(handle, 0, 10000), 0)
  assert_true(!native_video_error(handle).is_empty())
  assert_eq(native_video_crop(handle, 1900, 0, 500, 200), 0)
  assert_eq(native_video_mute(handle, 2), 0)
  @test_support.expect_json(native_video_snapshot(handle), before)
  assert_eq(native_video_undo(handle), 1)
  assert_eq(native_video_error(handle), "")
  assert_eq(native_video_duration(handle), 8000)
  assert_eq(native_video_redo(handle), 1)
  @test_support.expect_json(native_video_snapshot(handle), before)
  let resumed = native_video_resume(10000, 1280, 720, 0, before)
  assert_true(resumed > 0 && resumed != handle)
  assert_eq(native_video_duration(resumed), 7000)
  assert_eq(native_video_crop_value(resumed, 2), 1280)
  assert_eq(native_video_crop_value(resumed, 3), 720)
  let source = @test_support.model_test_field(@json.parse(native_video_snapshot(resumed)), "source")
  assert_eq(@test_support.model_test_field(source, "hasAudio"), Json(false))
  assert_eq(native_video_reset(handle), 1)
  assert_eq(native_video_duration(handle), 10000)
  assert_eq(native_video_segment_count(handle), 1)
  assert_eq(native_video_undo(handle), 1)
  @test_support.expect_json(native_video_snapshot(handle), before)
  native_video_close(handle)
  native_video_close(resumed)
}

///|
test "native video C ABI safely handles invalid handles fields and source limits" {
  assert_eq(native_video_open(0, 1920, 1080, 0), 0)
  assert_true(!native_video_error(0).is_empty())
  assert_eq(native_video_open(604800001, 1920, 1080, 0), 0)
  assert_eq(native_video_open(1000, 1, 1080, 0), 0)
  assert_eq(native_video_open(1000, 1920, 1080, -1), 0)
  assert_eq(native_video_resume(1000, 1920, 1080, 0, "{broken"), 0)
  let handle = native_video_open(604800000, 32768, 32768, 0)
  assert_true(handle > 0)
  assert_eq(native_video_error(0), "")
  assert_eq(native_video_duration(handle), 604800000)
  assert_eq(native_video_segment_value(handle, 0, 1), 604800000)
  assert_eq(native_video_segment_value(handle, -1, 0), -1)
  assert_eq(native_video_segment_value(handle, 1, 0), -1)
  assert_eq(native_video_segment_value(handle, 0, 4), -1)
  assert_eq(native_video_crop_value(handle, -1), -1)
  assert_eq(native_video_edit_value(handle, 6), -1)
  native_video_close(handle)
  for invalid in [-2147483648, -1, 0, handle, 2147483647] {
    assert_eq(native_video_duration(invalid), 0)
    assert_eq(native_video_segment_count(invalid), 0)
    assert_eq(native_video_segment_value(invalid, 0, 0), -1)
    assert_eq(native_video_crop_value(invalid, 0), -1)
    assert_eq(native_video_edit_value(invalid, 0), -1)
    assert_eq(native_video_snapshot(invalid), "")
    assert_eq(native_video_trim(invalid, 0, 100), 0)
    assert_eq(native_video_reset(invalid), 0)
    native_video_close(invalid)
  }
}
